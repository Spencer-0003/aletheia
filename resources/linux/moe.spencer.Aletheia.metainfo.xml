  <name>Aletheia</name>
  <summary>Game save backup tool</summary>
  <content_rating type="oars-1.1"/>

  <developer id="moe.spencer">
    <name>Spencer</name>
  </developer>

  <branding>
    <color type="primary" scheme_preference="light">#7678ed</color>
    <color type="primary" scheme_preference="dark">#5658c4</color>
  </branding>

  <metadata_license>CC0-1.0</metadata_license>
  <project_license>AGPL-3.0-only</project_license>

  <description>
    <p>Aletheia is a cross-platform game save sync tool designed to help you easily back up and restore game saves across multiple game launchers and devices.</p>
    <p>Supported launchers include:</p>
    <ul>
      <li>Heroic Games</li>
      <li>itch.io</li>
      <li>Lutris</li>
      <li>Steam</li>
    </ul>
  </description>

