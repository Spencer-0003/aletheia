import { ThemeLogic } from "../logic/theme.slint";

export enum NotificationType {
  SUCCESS,
  ERROR,
  INFO,
  WARNING
}

export component Notification inherits Rectangle {
  in property <string> message;
  in property <NotificationType> notification_type: NotificationType.INFO;
  in property <duration> show_duration: 2500ms;
  in property <length> target_x;
  callback closed <=> close_timer.triggered;

  width: notification_layout.preferred-width + 24px;
  height: notification_layout.preferred-height + 16px;
  x: animated_in ? target_x : target_x + self.width + 20px;
  background: ThemeLogic.colors.surface;
  border-radius: 8px;
  drop-shadow-blur: 8px;
  drop-shadow-color: ThemeLogic.colors.surface_shadow;
  drop-shadow-offset-y: 4px;

  accessible-role: text;
  accessible-label: root.message;
  accessible-live-region: root.notification_type == NotificationType.ERROR
    ? AccessibleLiveness.assertive
    : AccessibleLiveness.polite;

  animate x { duration: 225ms; easing: ease-out; }

  private property <bool> animated_in: false;
  private property <bool> should_close: false;
  private property <image> icon: notification_type == NotificationType.SUCCESS ? @image-url("../assets/check.svg") :
                                 notification_type == NotificationType.ERROR ? @image-url("../assets/cancel.svg") :
                                 notification_type == NotificationType.WARNING ? @image-url("../assets/warning.svg") :
                                 @image-url("../assets/info.svg");

  Timer {
    running: parent.visible && !root.should_close;
    interval: root.show_duration;
    triggered() => {
      root.should_close = true;
      root.animated_in = false;
    }
  }

  close_timer := Timer {
    running: root.should_close;
    interval: 250ms;
  }

  changed visible => {
    if (self.visible) {
      root.animated_in = true;
      root.should_close = false;
    }
  }

  TouchArea {
    mouse-cursor: root.should_close ? default : pointer;

    clicked() => {
      root.should_close = true;
      root.animated_in = false;
    }
  }

  notification_layout := HorizontalLayout {
    spacing: 6px;
    alignment: center;

    Image {
      source: root.icon;
      vertical-alignment: center;
    }

    Text {
      text: root.message;
      color: ThemeLogic.colors.text_primary;
      font-size: 14px;
      font-weight: 500;
      vertical-alignment: center;
      accessible-role: none;
    }
  }
}
