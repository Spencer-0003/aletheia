import { Button } from "./components/button.slint";
import { TextLabel } from "./components/text_label.slint";
import { NumberInput } from "./components/number_input.slint";
import { Dropdown } from "./components/dropdown.slint";
import { Scrollable } from "./components/scrollable.slint";
import { ThemeLogic } from "./logic/theme.slint";
import { SetupLogic } from "./logic/setup.slint";

component FirstTimeSetupContent inherits VerticalLayout {
  padding: 24px;
  padding-bottom: 12px;
  spacing: 24px;
  alignment: start;

  VerticalLayout {
    spacing: 8px;
    alignment: start;

    HorizontalLayout {
      alignment: center;

      Image {
        width: 80px;
        height: 80px;
        source: @image-url("../resources/logo/moe.spencer.Aletheia.svg");
      }
    }

    VerticalLayout {
      spacing: 2px;
      alignment: start;

      Text {
        text: @tr("Welcome to Aletheia");
        color: ThemeLogic.colors.text_secondary;
        font-size: 18px;
        font-weight: 600;
        horizontal-alignment: center;
      }

      Text {
        text: @tr("Let's get you set up. You can change these settings at any time.");
        color: ThemeLogic.colors.text_tertiary;
        font-size: 14px;
        horizontal-alignment: center;
        wrap: word-wrap;
      }
    }
  }

  VerticalLayout {
    spacing: 12px;
    alignment: start;

    VerticalLayout {
      spacing: 4px;
      alignment: start;

      Text {
        text: @tr("Backup Location");
        color: ThemeLogic.colors.text_secondary;
        font-size: 14px;
        font-weight: 600;
      }

      Text {
        text: @tr("Where your game saves will be stored on disk.");
        color: ThemeLogic.colors.text_tertiary;
        font-size: 12px;
      }
    }

    HorizontalLayout {
      spacing: 12px;

      TextLabel {
        text: SetupLogic.backup_path;
        height: 36px;
      }

      Button {
        text: @tr("Browse");
        width: 90px;
        height: 36px;
        clicked => SetupLogic.browse();
      }
    }
  }

  Rectangle { height: 1px; background: ThemeLogic.colors.secondary_hover; }

  VerticalLayout {
    spacing: 12px;
    alignment: start;

    VerticalLayout {
      spacing: 4px;
      alignment: start;

      Text {
        text: @tr("Backup Retention");
        color: ThemeLogic.colors.text_secondary;
        font-size: 14px;
        font-weight: 600;
      }

      Text {
        text: @tr("How many backups to keep per game.");
        color: ThemeLogic.colors.text_tertiary;
        font-size: 12px;
      }
    }

    NumberInput {
      width: 50px;
      height: 36px;
      minimum: 1;
      maximum: 255;
      value <=> SetupLogic.max_backups;
    }
  }

  @children
}

export component FirstTimeSetup inherits Window {
  private property <bool> has_steam_accounts: SetupLogic.steam_account_options.length > 0;

  title: @tr("Aletheia - First Time Setup");
  icon: @image-url("../resources/logo/moe.spencer.Aletheia.png");
  default-font-family: "Inter";
  width: 520px;
  height: root.has_steam_accounts ? 580px : 560px;
  preferred-width: 520px;
  preferred-height: root.has_steam_accounts ? 580px : 560px;
  background: ThemeLogic.colors.surface;

  Rectangle {
    width: 460px;
    height: root.has_steam_accounts ? 520px : 500px;
    background: ThemeLogic.colors.background;
    border-radius: 8px;
    border-width: 1px;
    border-color: ThemeLogic.colors.surface_border;
    drop-shadow-blur: 8px;
    drop-shadow-color: ThemeLogic.colors.surface_shadow;
    drop-shadow-offset-y: 4px;

    VerticalLayout {
      if root.has_steam_accounts: scrollable := Scrollable {
        FirstTimeSetupContent {
          Rectangle { height: 1px; background: ThemeLogic.colors.secondary_hover; }

          VerticalLayout {
            z: 1;
            spacing: 12px;
            alignment: start;

            VerticalLayout {
              spacing: 4px;
              alignment: start;

              Text {
                text: @tr("Steam Account");
                color: ThemeLogic.colors.text_secondary;
                font-size: 14px;
                font-weight: 600;
              }

              Text {
                text: @tr("Used to locate saves stored in Steam's userdata directory.");
                color: ThemeLogic.colors.text_tertiary;
                font-size: 12px;
              }
            }

            Dropdown {
              placeholder: @tr("Select an account…");
              options: SetupLogic.steam_account_options;
              value <=> SetupLogic.steam_account_id;
              changed expanded => {
                if self.expanded {
                  scrollable.viewport-y = scrollable.viewport-y - 200px;
                }
              }
            }
          }
        }
      }

      if !root.has_steam_accounts: FirstTimeSetupContent {}

      HorizontalLayout {
        padding: 24px;
        padding-top: 12px;
        alignment: end;

        Button {
          text: @tr("Continue");
          width: 120px;
          height: 36px;
          clicked => SetupLogic.continue();
        }
      }
    }
  }
}
